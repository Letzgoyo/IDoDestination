# Required for the admin dashboard
ADMIN_PASSWORD=change-me
SESSION_SECRET=long-random-string
# Where application alerts are sent
ADMIN_EMAIL=you@example.com
# SMTP connection, e.g. smtps://user:pass@smtp.example.com. Unset = emails are logged to console.
SMTP_URL=
MAIL_FROM="I Do Destination <hello@idodestination.com.au>"
SITE_URL=http://localhost:5173
# PORT=3001
# DB_PATH=data/idodestination.db
# Online payments (AUD) via Stripe Checkout. Unset = bookings become vendor-confirmed requests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform fee recorded on each booking (percent of service price)
PLATFORM_FEE_PERCENT=10
